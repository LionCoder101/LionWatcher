{
  "configVersion": "v3",
  "app": {
    "appId": 20001,
    "appName": "LionTracker",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Cryptocurrency market tracker and recent trades"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.bg_service",
    "device:os.notification",
    "device:os.alarm"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0.0"
    }
  },
  "debug": false,
  "targets": {
    "gtr4": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "app-service": {
          "services": ["app-service/index"]
        }
      },
      "platforms": [
        {
          "name": "gtr4",
          "deviceSource": 7930112
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "LionTracker"
    }
  },
  "defaultLanguage": "en-US"
}
